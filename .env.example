APP_NAME=Tupay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Honoured by the PHP CLI server on POSIX platforms only. On Linux/CI this is
# what gives the concurrency test real parallelism; Windows PHP ignores it.
PHP_CLI_SERVER_WORKERS=10

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL. Port 5433 by default so this cluster can coexist with any other
# PostgreSQL already occupying 5432.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=tupay
DB_USERNAME=postgres
DB_PASSWORD=tupay_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Redis backs the elevated-action tokens, the distributed swap locks, the
# stale-while-revalidate rate cache, and the settlement queue.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=tupay_cache_

# `predis` (pure PHP) works everywhere including Windows/XAMPP. Set to
# `phpredis` if the C extension is available — CI uses phpredis, so both
# drivers are exercised rather than only the convenient one.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# Tupay domain configuration
#--------------------------------------------------------------------------

# Elevated Action Token: single-use, 60-second TTL, bound to a SHA-256 hash
# of the intended action and its exact parameters.
TUPAY_EAT_TTL=60
TUPAY_EAT_ISSUER=tupay-step-up

# Distributed lock hold time. Must exceed the worst-case swap duration but stay
# short enough that a crashed process cannot wedge a wallet for long.
# BLOCK_SECONDS=0 means contenders fail fast with 409 rather than queueing.
TUPAY_LOCK_TTL=10
TUPAY_LOCK_BLOCK_SECONDS=0

# Stale-while-revalidate rate cache.
TUPAY_RATE_ENDPOINT=http://127.0.0.1:8000/api/mock/rates
TUPAY_RATE_FRESH_TTL=30
TUPAY_RATE_STALE_TTL=300

# Tiered slippage: 0.5% base above the threshold, +0.1% per additional
# 500,000 NGN. Expressed in kobo and basis points to stay integer-only.
TUPAY_SLIPPAGE_THRESHOLD_KOBO=100000000
TUPAY_SLIPPAGE_BASE_BPS=50
TUPAY_SLIPPAGE_STEP_KOBO=50000000
TUPAY_SLIPPAGE_STEP_BPS=10

# HMAC-SHA256 shared secret for POST /api/webhooks/settlement.
# CHANGE THIS before any deployment.
TUPAY_WEBHOOK_SECRET=tupay_local_webhook_secret_change_me
TUPAY_WEBHOOK_TOLERANCE=300

#--------------------------------------------------------------------------
# Concurrency test
#--------------------------------------------------------------------------
# The stress suite fires real HTTP at a running server, so it must target the
# same database and Redis index that server is using.
STRESS_TEST_BASE_URL=http://127.0.0.1:8000
STRESS_TEST_DB=tupay
STRESS_TEST_REDIS_DB=0
STRESS_TEST_TIMEOUT=120
