  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// ---------------------------------------------------------------",
          "// Shared helpers, available to every request in the collection.",
          "// ---------------------------------------------------------------",
          "",
          "// RFC 4648 base32 -> hex, so CryptoJS can HMAC the raw seed.",
          "// Authenticator secrets are base32, but HMAC needs bytes.",
          "function base32ToHex(base32) {",
          "    const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';",
          "    let bits = '';",
          "    let hex = '';",
          "",
          "    const clean = base32.replace(/=+$/, '').toUpperCase();",
          "",
          "    for (let i = 0; i < clean.length; i++) {",
          "        const val = alphabet.indexOf(clean.charAt(i));",
          "        if (val === -1) { throw new Error('Invalid base32 character: ' + clean.charAt(i)); }",
          "        bits += val.toString(2).padStart(5, '0');",
          "    }",
          "",
          "    // Whole bytes only; a trailing partial group carries no data.",
          "    for (let i = 0; i + 8 <= bits.length; i += 8) {",
          "        hex += parseInt(bits.substr(i, 8), 2).toString(16).padStart(2, '0');",
          "    }",
          "",
          "    return hex;",
          "}",
          "",
          "// RFC 6238 TOTP: HMAC-SHA1 over the 30-second counter, then the",
          "// standard dynamic-truncation step down to 6 digits.",
          "function generateTotp(secret) {",
          "    const CryptoJS = require('crypto-js');",
          "",
          "    const counter = Math.floor(Date.now() / 1000 / 30);",
          "    const counterHex = counter.toString(16).padStart(16, '0');",
          "",
          "    const hmac = CryptoJS.HmacSHA1(",
          "        CryptoJS.enc.Hex.parse(counterHex),",
          "        CryptoJS.enc.Hex.parse(base32ToHex(secret))",
          "    ).toString(CryptoJS.enc.Hex);",
          "",
          "    // Low 4 bits of the last byte select where to read the 4-byte code.",
          "    const offset = parseInt(hmac.substr(hmac.length - 1), 16);",
          "    const binary = parseInt(hmac.substr(offset * 2, 8), 16) & 0x7fffffff;",
          "",
          "    return (binary % 1000000).toString().padStart(6, '0');",
          "}",
          "",
          "// Sign exactly what the middleware verifies: '{timestamp}.{raw body}'.",
          "// The body must be sent byte-for-byte as signed — re-serialising it",
          "// would change key order or spacing and invalidate the signature.",
          "function signWebhook(rawBody) {",
          "    const CryptoJS = require('crypto-js');",
          "    const ts = Math.floor(Date.now() / 1000).toString();",
          "",
          "    const signature = CryptoJS.HmacSHA256(",
          "        ts + '.' + rawBody,",
          "        pm.collectionVariables.get('webhookSecret')",
          "    ).toString(CryptoJS.enc.Hex);",
          "",
          "    pm.collectionVariables.set('webhookTimestamp', ts);",
          "    pm.collectionVariables.set('webhookSignature', signature);",
          "}",
          "",
          "this.base32ToHex = base32ToHex;",
          "this.generateTotp = generateTotp;",
          "this.signWebhook = signWebhook;"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Happy path",
      "description": "Login → challenge → swap. Run these in order; each populates variables the next one needs.",
      "item": [
        {
          "name": "1. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('returns a bearer token', () => {",
                  "    pm.expect(body.token_type).to.eql('Bearer');",
                  "    pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('user is enrolled in TOTP', () => {",
                  "    pm.expect(body.user.totp_enrolled).to.be.true;",
                  "});",
                  "",
                  "pm.test('exposes wallet ids so the ledger is reachable', () => {",
                  "    pm.expect(body.wallets).to.be.an('array').with.length.above(0);",
                  "});",
                  "",
                  "pm.collectionVariables.set('bearer', body.access_token);",
                  "pm.collectionVariables.set('userId', body.user.id);",
                  "",
                  "// Capture wallet ids so the Ledger folder needs no manual setup.",
                  "const ngn = body.wallets.find(w => w.currency === 'NGN');",
                  "const cny = body.wallets.find(w => w.currency === 'CNY');",
                  "",
                  "if (ngn) { pm.collectionVariables.set('ngnWalletId', ngn.id); }",
                  "if (cny) { pm.collectionVariables.set('cnyWalletId', cny.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"postman\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/login", "host": ["{{baseUrl}}"], "path": ["api", "login"] },
            "description": "Exchanges credentials for a Sanctum bearer token. This token is sufficient for read-only endpoints and deliberately NOT sufficient for /api/swap."
          }
        },
        {
          "name": "2. 2FA challenge → mint EAT",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Compute a live TOTP code from the seeded secret.",
                  "const code = generateTotp(pm.collectionVariables.get('totpSecret'));",
                  "pm.collectionVariables.set('totpCode', code);",
                  "console.log('TOTP code for this request:', code);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('token expires in 60 seconds', () => {",
                  "    pm.expect(body.expires_in).to.eql(60);",
                  "});",
                  "",
                  "pm.test('bound to a SHA-256 action hash', () => {",
                  "    pm.expect(body.action_hash).to.have.lengthOf(64);",
                  "});",
                  "",
                  "pm.test('token is signed (payload.signature)', () => {",
                  "    pm.expect(body.elevated_action_token).to.include('.');",
                  "});",
                  "",
                  "pm.collectionVariables.set('eat', body.elevated_action_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bearer}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totp_code\": \"{{totpCode}}\",\n  \"action\": \"swap\",\n  \"action_payload\": {\n    \"source_currency\": \"NGN\",\n    \"target_currency\": \"CNY\",\n    \"amount_subunits\": {{swapAmount}}\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/2fa/challenge", "host": ["{{baseUrl}}"], "path": ["api", "2fa", "challenge"] },
            "description": "Spends a TOTP code and returns an Elevated Action Token bound to a SHA-256 hash of these exact parameters and this exact user. The raw TOTP code never travels with the swap itself."
          }
        },
        {
          "name": "3. Swap (succeeds, consumes the EAT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('below the slippage threshold, so no spread', () => {",
                  "    pm.expect(body.slippage_bps).to.eql(0);",
                  "});",
                  "",
                  "pm.test('target wallet was credited', () => {",
                  "    pm.expect(body.target.credited_subunits).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('balances are reported as derived values', () => {",
                  "    pm.expect(body.balances).to.have.property('NGN');",
                  "    pm.expect(body.balances).to.have.property('CNY');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bearer}}" },
              { "key": "X-Elevated-Action-Token", "value": "{{eat}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source_currency\": \"NGN\",\n  \"target_currency\": \"CNY\",\n  \"amount_subunits\": {{swapAmount}}\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/swap", "host": ["{{baseUrl}}"], "path": ["api", "swap"] },
            "description": "Posts four balanced ledger legs: debit user NGN, credit system NGN, debit system CNY, credit user CNY. Each currency nets to zero independently."
          }
        }
      ]
    },
    {
      "name": "Attacks",
      "description": "Every one of these must fail. Run 'Happy path' first — several reuse the now-spent EAT deliberately.",
      "item": [
