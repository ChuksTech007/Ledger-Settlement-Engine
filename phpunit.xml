<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!--
            The concurrency suite fires real parallel HTTP requests at a running
            server, so it cannot use RefreshDatabase (the server would not see a
            test transaction) and is kept separate for that reason.
        -->
        <testsuite name="Stress">
            <directory>tests/Stress</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>

        <!--
            The ledger invariants under test are PostgreSQL features: stored
            generated columns, DEFERRABLE CONSTRAINT TRIGGERs, and partial
            unique indexes. Running the suite on SQLite would silently skip
            every guarantee that matters, so the tests target a real Postgres.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5433"/>
        <env name="DB_DATABASE" value="tupay_test"/>
        <env name="DB_USERNAME" value="postgres"/>
        <env name="DB_PASSWORD" value="tupay_secret"/>

        <!--
            Real Redis, on a dedicated database index so a test run can never
            clobber development keys. The EAT single-use guarantee depends on
            an atomic GETDEL, which an array cache driver cannot model.
        -->
        <env name="REDIS_CLIENT" value="predis"/>
        <env name="REDIS_HOST" value="127.0.0.1"/>
        <env name="REDIS_PORT" value="6379"/>
        <env name="REDIS_DB" value="15"/>
        <env name="REDIS_CACHE_DB" value="15"/>
        <env name="CACHE_STORE" value="redis"/>

        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>

        <env name="TUPAY_WEBHOOK_SECRET" value="test_webhook_secret"/>
        <env name="TUPAY_EAT_TTL" value="60"/>
    </php>
</phpunit>
